# Crée une appli sur https://www.strava.com/settings/api puis colle les valeurs ici.
STRAVA_CLIENT_ID=xxxxx
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publique de ton déploiement, sans slash final.
# En local : http://localhost:3000
# En prod  : https://ton-app.vercel.app
APP_URL=http://localhost:3000

# Secret pour chiffrer le cookie de session (32 caractères minimum).
# Génère-en un avec : openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-char-string
